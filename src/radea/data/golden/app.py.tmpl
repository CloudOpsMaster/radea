"""A small health endpoint with structured request logs."""

import json
import os
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


def response(path):
    if path == "/healthz":
        return 200, {"status": "ok"}
    return 404, {"status": "not_found"}


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        status, payload = response(self.path)
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
        print(json.dumps({"event": "request", "status": status}), flush=True)

    def log_message(self, _format, *_args):
        pass


if __name__ == "__main__":
    with ThreadingHTTPServer(("0.0.0.0", int(os.getenv("PORT", "8080"))), Handler) as server:
        server.serve_forever()
